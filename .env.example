# ============================================================
# Plantilla de variables de entorno — leads-auth-api
# Sistema Integral de Gestión de Leads
# ============================================================
# INSTRUCCIONES:
#   1. Copie este archivo con el nombre .env
#   2. Complete los valores reales según su entorno local
#   3. NUNCA suba el archivo .env al repositorio
#   4. El archivo .env ya está incluido en .gitignore
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=3000

# ── Base de datos MySQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=su_contraseña_aqui
DB_NAME=leads_db

# ── Seguridad JWT ─────────────────────────────────────────────
# Mínimo 32 caracteres — cambiar obligatoriamente en producción
JWT_SECRET=clave_secreta_minimo_32_caracteres_cambiar_en_produccion
JWT_EXPIRES_IN=8h